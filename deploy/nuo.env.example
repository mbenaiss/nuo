# Nuo Gateway environment: ~/.secrets/nuo.env (chmod 600), linked from
# ~/nuo/config/env and loaded by the systemd unit (EnvironmentFile). scripts/install.sh copies this file once and
# never overwrites it. Every setting is optional: the gateway starts with this file left as is.
# On macOS the launchd agent loads it with `bun --env-file`, which expands $NAME and ends an unquoted value at #:
# write such a value in double quotes, with \$ for a literal $.
# An empty value means "not set". Lines left commented change behaviour when present even if empty
# (an empty override path, an empty proxy list, an empty API key handed to an agent CLI): uncomment them only
# with a value.

# --- Server ---
# Listening port (default 8790) and address (default: all interfaces).
NUO_PORT=
NUO_HOST=
# Token accepted only from a direct loopback connection (scripts/nuo-notify, the bots' nuo MCP server).
# install.sh fills it with a random value when it creates this file; without it a new one is drawn at every start.
NUO_LOCAL_TOKEN=
# Agent sessions running at once (default 3).
NUO_MAX_SESSIONS=
# "0" disables compacting a nearly full agent context before a prompt.
NUO_AUTO_COMPACT=

# --- Auth (docs/security.md) ---
# Seals the TOTP secret in nuo.db. Written here by `bun run src/cli.ts auth-totp-setup`; keep it out of backups.
# NUO_AUTH_KEY=
# Other secrets file read for NUO_AUTH_KEY (default ~/.secrets/nuo.env).
# NUO_SECRETS_FILE=

# --- Network zones (docs/protocol.md) ---
# Peers running cloudflared (or another tunnel adding Cloudflare headers), comma separated: their
# Cf-Connecting-Ip is the client address.
NUO_TUNNEL_SOURCES=
# Reverse proxies on your local network or VPN (Caddy, nginx...), comma separated: their X-Forwarded-For is the
# client address. Unset means 127.0.0.1,::1; an empty value trusts no proxy.
# NUO_PROXY_SOURCES=
# Internet URL handed to the apps at pairing, e.g. https://nuo.example.com (tunnel hostname).
NUO_PUBLIC_URL=
# Cloudflare Access service token handed to the apps at pairing (both or neither).
NUO_CF_ACCESS_CLIENT_ID=
NUO_CF_ACCESS_CLIENT_SECRET=

# --- Push (APNs); push is off unless all four are set ---
# Path of the .p8 key, e.g. /home/<user>/nuo/config/apns.p8 (chmod 600).
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=

# --- Calendar and public booking pages (docs/calendar.md) ---
# Comma list of public booking hostnames; empty turns the public pages off.
NUO_BOOKING_HOSTS=
# Base URL used in links and emails (default https://<first booking host>).
NUO_BOOKING_BASE_URL=
# Name shown on the public pages and in the .ics title.
NUO_BOOKING_OWNER=
# What follows @ in the UID of the .ics files (default nuo). Keep the value of the first invitations if the install
# was renamed since: a guest's calendar recognizes a booking it already has by this UID.
# NUO_BOOKING_UID_DOMAIN=
NUO_TURNSTILE_SITEKEY=
NUO_TURNSTILE_SECRET=
# Default Google target account[/calendarId], and the accounts listed in the app.
NUO_GOOGLE_CALENDAR=
NUO_GOOGLE_ACCOUNTS=
# Address printed on the public /privacy and /terms pages; left empty, they carry no contact line.
NUO_LEGAL_CONTACT=
# gog binary (default: gog on PATH).
NUO_GOG_BIN=
# Unlocks gog's file keyring; inherited by gog and by the agents.
GOG_KEYRING_PASSWORD=

# --- Wake-ups from outside: webhooks and bot mail (docs/protocol.md, deploy/mail-worker/README.md) ---
# Comma list of hostnames that serve POST /hooks/<token> and POST /mail only, outside Cloudflare Access; empty turns
# webhooks off. Webhook URLs are built on the first one. E.g. hooks.example.com.
NUO_HOOKS_HOSTS=
# Shared with the mail Worker (its MAIL_SECRET secret); empty, POST /mail does not exist. openssl rand -base64 32
NUO_MAIL_SECRET=
# Domain of the bots' addresses (<slug>@domain), routed by Cloudflare Email Routing to the Worker. Never the apex:
# the apex usually receives the owner's own mail elsewhere. E.g. bots.example.com.
NUO_MAIL_DOMAIN=
# The owner's own addresses: their mail, when Cloudflare verified it (DKIM, SPF or DMARC), runs as a goal.
NUO_OWNER_EMAILS=
# authserv-id of Cloudflare's Authentication-Results header (default mx.cloudflare.net).
NUO_MAIL_AUTHSERV_ID=

# --- Google accounts (docs/protocol.md); the three are needed to connect a Google account from the app ---
# « Web application » client of the Google Cloud project. The redirect URI defaults to NUO_BOOKING_BASE_URL +
# /oauth/google/callback and must be listed on the client, character for character.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# --- Parcel tracking (docs/protocol.md, Scanning and parcels); without Ship24 or 17TRACK, only La Poste parcels get an automatic status ---
# La Poste (Colissimo, Chronopost, lettres suivies) is always tracked; this optional developer.laposte.fr key switches it to the official Suivi v2 API.
NUO_LAPOSTE_OKAPI_KEY=
# Ship24 (every carrier), key from dashboard.ship24.com; the free plan tracks 10 new numbers a month.
NUO_SHIP24_API_KEY=
# 17TRACK (every carrier, used when Ship24 fails or is out of quota), key from api.17track.net; each new number spends one unit of the account's quota.
NUO_SEVENTEENTRACK_API_KEY=

# --- Cosmetics (Scanning) : Open Beauty Facts, UPCitemdb and Open Products Facts need no key ---
# INCI API, free key from inciapi.com/dashboard/api-keys: 2 000 products found a month, unknown codes are free.
NUO_INCIAPI_KEY=

# --- Speech to text for dictation and meetings (docs/protocol.md, Speech to text); without it the apps transcribe on the device only ---
# Provider behind POST /api/transcriptions; elevenlabs is the default and the only one so far.
NUO_TRANSCRIPTION_PROVIDER=elevenlabs
# ElevenLabs key with Speech to Text access (and single-use tokens for older app builds); it never leaves the gateway.
NUO_ELEVENLABS_API_KEY=
# Scribe model, scribe_v3 by default; scribe_v2 still works without secondary languages and number formatting.
NUO_ELEVENLABS_STT_MODEL=

# --- Public links to documents (docs/data.md, POST /api/docs/drop); both or neither ---
# drop instance (static file host) and an API key from its « API keys » tab; the key never leaves the gateway.
NUO_DROP_URL=
NUO_DROP_API_KEY=

# --- Muscu screen of the apps (docs/protocol.md): the fitness coach's checkout (data/fitness.db, webapp/chrono) ---
# Optional: it reads an external fitness database that is not part of this repository; without these variables the
# Muscu routes answer 404 and the screen has nothing to show.
NUO_FITNESS_DIR=
# NUO_FITNESS_DB=

# --- Apps built under an earlier name (docs/install.md); leave empty unless the project was renamed ---
# The earlier name, lowercase: apps installed before the rename keep working until each one is updated.
# Remove it once every iPhone, Mac and watch runs a build of the current name.
NUO_LEGACY_APP_PREFIX=

# --- Layout overrides (docs/layout.md); the unit sets NUO_HOME=%h/nuo ---
# NUO_HOME=
# NUO_DATA_DIR=
# NUO_CONFIG_DIR=

# --- Agent CLIs: only when not logged in interactively, or not using the default folders ---
# ANTHROPIC_API_KEY=
# CLAUDE_CONFIG_DIR=
# CODEX_API_KEY=
# OPENAI_API_KEY=
# CODEX_HOME=
# CODEX_PATH=
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_CLOUD_PROJECT=
# GEMINI_CLI_HOME=
