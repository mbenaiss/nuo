{
  "sourceLanguage": "en",
  "strings": {
    "NSCalendarsFullAccessUsageDescription": {
      "comment": "Privacy - NSCalendarsFullAccessUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nuo shows your calendars, works out when you're free and lets your bots read, create and edit your events, iCloud included, when you ask them. You choose what they can do in Settings › Bot Access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuo affiche tes calendriers, calcule tes disponibilités et laisse tes bots lire, créer et modifier tes évènements, iCloud compris, quand tu le leur demandes. Tu choisis ce qu'ils peuvent faire dans Réglages › Accès des bots."
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "comment": "Privacy - NSCameraUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "To send a photo to a bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour envoyer une photo à un bot."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Privacy - NSFaceIDUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Face ID unlocks Nuo and confirms sensitive actions (devices, finances, commands)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID déverrouille Nuo et confirme les actions sensibles (appareils, finances, commandes)."
          }
        }
      }
    },
    "NSHealthShareUsageDescription": {
      "comment": "Privacy - NSHealthShareUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "To answer your bots when you ask them about your fitness: activity, cardio, sleep, workouts and weight. Nuo reads Health only when a request comes in, keeps nothing and sends nothing to the gateway beyond the answer. You choose the data shared, and you turn off access in Settings › Bot Access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour répondre à tes bots quand tu les interroges sur ta forme : activité, cardio, sommeil, séances et poids. Nuo lit Santé seulement au moment d'une demande, ne garde rien et n'envoie rien à la passerelle en dehors de la réponse. Tu choisis les données partagées, et tu coupes l'accès dans Réglages › Accès des bots."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - NSLocalNetworkUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nuo connects to your gateway on the local network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuo se connecte à ta passerelle sur le réseau local."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "comment": "Privacy - NSLocationAlwaysAndWhenInUseUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "With “Always”, your bots get your location even when Nuo is closed, for example for directions or the weather here. Nuo only reads it when a request comes in, never continuously."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec « Toujours », tes bots obtiennent ta position même quand Nuo est fermé, par exemple pour un trajet ou la météo d'ici. Nuo la lit seulement au moment d'une demande, jamais en continu."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "comment": "Privacy - NSLocationWhenInUseUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "For location reminders, and to answer your bots when you ask them where you are, the weather or directions from here. Nuo doesn't track your location: it only reads it when a request comes in."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les rappels de lieu, et pour répondre à tes bots quand tu leur demandes où tu es, la météo ou un trajet depuis ici. Nuo ne suit pas ta position : il la lit seulement au moment d'une demande."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "Privacy - NSMicrophoneUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Nuo listens to your voice so you can talk with your bots."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuo écoute ta voix pour parler avec tes bots."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription": {
      "comment": "Privacy - NSPhotoLibraryUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "To send a photo to a bot."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour envoyer une photo à un bot."
          }
        }
      }
    },
    "NSSpeechRecognitionUsageDescription": {
      "comment": "Privacy - NSSpeechRecognitionUsageDescription",
      "extractionState": "extracted_with_value",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Your voice is transcribed on the iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transcription de ta voix se fait sur l'iPhone."
          }
        }
      }
    }
  },
  "version": "1.0"
}
