    "demo.transport.remote" : {
      "comment" : "Demo answer with two question cards",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The living room remote hasn't responded since this morning. Two questions before I act:\n::question {\"question\":\"Which one first?\",\"options\":[\"Re-pair the remote\",\"Remove the device\"],\"multiple\":false}\n::question {\"question\":\"Which rooms should the vacuum clean meanwhile?\",\"options\":[\"Living room\",\"Kitchen\",\"Bedroom\"],\"multiple\":true}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La télécommande du salon ne répond plus depuis ce matin. Deux questions avant d'agir :\n::question {\"question\":\"On commence par laquelle ?\",\"options\":[\"Réappairer la télécommande\",\"Supprimer l'appareil\"],\"multiple\":false}\n::question {\"question\":\"L'aspirateur passe dans quelles pièces pendant ce temps ?\",\"options\":[\"Salon\",\"Cuisine\",\"Chambre\"],\"multiple\":true}"
          }
        }
      }
    },
    "demo.transport.status" : {
      "comment" : "Demo answer of the status command, a callout card",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "::callout {\"style\":\"success\",\"title\":\"Everything is up\",\"text\":\"nuo-gateway, lumen-api and postgres are responding. Last deployment 4 h ago.\"}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "::callout {\"style\":\"success\",\"title\":\"Tout est en ligne\",\"text\":\"nuo-gateway, lumen-api et postgres répondent. Dernier déploiement il y a 4 h.\"}"
          }
        }
