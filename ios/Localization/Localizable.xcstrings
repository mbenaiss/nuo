      }
    },
    "The bot didn't answer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot didn't answer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot n'a pas répondu."
          }
        }
      }
    },
    "The bot fills it in itself when you tell it “remember that…” or when it learns a lasting preference. You can also add a fact here." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot fills it in itself when you tell it “remember that…” or when it learns a lasting preference. You can also add a fact here."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot la remplit lui-même quand tu lui dis « retiens que… » ou qu'il apprend une préférence durable. Tu peux aussi ajouter un fait ici."
          }
        }
      }
    },
    "The bot finds and reads all your conversations with all bots, and puts your questions to the bot that can answer them. Keep this for a general-purpose bot: a bot that reads emails or web pages does not need it." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot finds and reads all your conversations with all bots, and puts your questions to the bot that can answer them. Keep this for a general-purpose bot: a bot that reads emails or web pages does not need it."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot retrouve et lit toutes tes conversations, avec tous les bots, et pose tes questions au bot qui sait y répondre. Réserve-le à un bot généraliste : un bot qui lit des e-mails ou des pages web n'en a pas besoin."
          }
        }
      }
    },
    "The bot is taking too long to answer." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot is taking too long to answer."
