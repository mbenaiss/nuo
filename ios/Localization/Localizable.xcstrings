    },
    "The bot sees it through without asking you at each step. It will still ask you to confirm sending an email, an invitation or a deletion. Stays on until you turn it off." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot sees it through without asking you at each step. It will still ask you to confirm sending an email, an invitation or a deletion. Stays on until you turn it off."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot va jusqu'au bout sans te demander à chaque étape. Il te fera confirmer un envoi d'e-mail, une invitation ou une suppression. Reste actif jusqu'à ce que tu le désactives."
          }
        }
