    "When a video call from your calendar starts, or when a meeting app uses the microphone, Nuo offers to transcribe. Detection happens on this Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When a video call from your calendar starts, or when a meeting app uses the microphone, Nuo offers to transcribe. Detection happens on this Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand une visio de ton agenda commence, ou quand une app de réunion utilise le micro, Nuo propose de transcrire. La détection se fait sur ce Mac."
          }
        }
      }
    },
    "When arriving at %@" : {
      "localizations" : {
