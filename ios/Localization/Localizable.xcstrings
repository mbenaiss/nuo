        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I merged PR #23, the deployment is running.\n\n```bash\n./scripts/deploy-gateway.sh\n✓ build 41 s\n✓ restart nuo-gateway.service\n```\n::callout {\"style\":\"success\",\"title\":\"Deployed\",\"text\":\"The gateway is running v0.1.0.\"}"
          }
        },
        "fr" : {
          "stringUnit" : {
