      "comment" : "Demo weather answer with a weather card (Fahrenheit in English)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tomorrow in Paris: cloudy, **61 to 75 °F**, with a 45% drizzle risk late in the day.\n::weather {\"location\":\"Paris\",\"temperature\":64,\"condition\":\"Cloudy\",\"icon\":\"cloud\",\"high\":75,\"low\":59,\"forecast\":[{\"day\":\"Today\",\"high\":75,\"low\":59,\"icon\":\"cloud\"},{\"day\":\"Sun\",\"high\":75,\"low\":61,\"icon\":\"rain\"},{\"day\":\"Mon\",\"high\":77,\"low\":55,\"icon\":\"partly\"},{\"day\":\"Tue\",\"high\":73,\"low\":54,\"icon\":\"sun\"}]}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demain à Paris : nuageux, **16–24 °C**, 45 % de risque de pluie en fin de journée.\n::weather {\"location\":\"Paris\",\"temperature\":18,\"condition\":\"Nuageux\",\"icon\":\"cloud\",\"high\":24,\"low\":15,\"forecast\":[{\"day\":\"Auj.\",\"high\":24,\"low\":15,\"icon\":\"cloud\"},{\"day\":\"Dim.\",\"high\":24,\"low\":16,\"icon\":\"rain\"},{\"day\":\"Lun.\",\"high\":25,\"low\":13,\"icon\":\"partly\"},{\"day\":\"Mar.\",\"high\":23,\"low\":12,\"icon\":\"sun\"}]}"
