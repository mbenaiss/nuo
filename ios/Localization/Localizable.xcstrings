      }
    },
    "The bot did not answer. Try again: the transcript is kept." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot did not answer. Try again: the transcript is kept."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot n'a pas répondu. Réessaie : la transcription est gardée."
          }
