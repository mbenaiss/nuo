    "The audio is arriving from the watch." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio is arriving from the watch."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio arrive de la montre."
          }
        }
      }
    },
    "The audio leaves the watch once it is on the iPhone, then the iPhone and your gateway once transcribed, unless you keep it. Nothing goes anywhere but to your gateway. The bot that writes reads other people's speech: the General bot and those with full access are not offered." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio leaves the watch once it is on the iPhone, then the iPhone and your gateway once transcribed, unless you keep it. Nothing goes anywhere but to your gateway. The bot that writes reads other people's speech: the General bot and those with full access are not offered."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio quitte la montre une fois sur l'iPhone, puis l'iPhone et ta passerelle une fois transcrit, sauf si tu le gardes. Rien ne part ailleurs que vers ta passerelle. Le bot qui rédige lit la parole d'autres personnes : le bot Général et ceux en accès complet ne sont pas proposés."
          }
        }
      }
    },
    "The audio, transcript and summary are deleted from the iPhone. The document already saved in Docs › reunions stays." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The audio, transcript and summary are deleted from the iPhone. The document already saved in Docs › reunions stays."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'audio, la transcription et le compte rendu sont supprimés de l'iPhone. Le document déjà enregistré dans Docs › reunions reste."
          }
        }
      }
    },
    "The bot" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot"
          }
        }
      }
    },
    "The bot acts without asking. Keep this for bots you trust." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot acts without asking. Keep this for bots you trust."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot agit sans demander. À réserver aux bots de confiance."
          }
        }
      }
    },
    "The bot asks before each sensitive action (command, write)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot asks before each sensitive action (command, write)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le bot demande avant chaque action sensible (commande, écriture)."
          }
        }
      }
    },
    "The bot can read but never edit or run anything." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The bot can read but never edit or run anything."
